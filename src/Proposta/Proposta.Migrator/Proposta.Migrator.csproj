<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Proposta.Infrastructure\Proposta.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit, even though Proposta.Infrastructure references both transitively - without
         it, NuGet resolves Microsoft.EntityFrameworkCore to whatever version Npgsql's own
         dependency graph asks for instead of this repo's centrally managed one, which breaks
         at compile time against Proposta.Infrastructure.dll (CS1705, assembly version mismatch). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
