# Copy this file to .env and adjust as needed. docker-compose reads .env automatically.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Per-service Postgres roles created by docker/postgres-init/init-databases.sh:
#   *_migrator - owns the schema (DDL), used only by the *.Migrator console apps.
#   *_app      - DML only (SELECT/INSERT/UPDATE/DELETE), used by the running API.
# POSTGRES_USER/PASSWORD above are only used to bootstrap these roles and are never
# passed to the API or Migrator containers.
PROPOSTA_MIGRATOR_PASSWORD=proposta_migrator
PROPOSTA_APP_PASSWORD=proposta_app
CONTRATACAO_MIGRATOR_PASSWORD=contratacao_migrator
CONTRATACAO_APP_PASSWORD=contratacao_app
ANALISE_MIGRATOR_PASSWORD=analise_migrator
ANALISE_APP_PASSWORD=analise_app

RABBITMQ_USER=insurance
RABBITMQ_PASSWORD=insurance

# Shared across the three services - all validate the same JWT.
JWT_ISSUER=InsurancePlatformV01
JWT_AUDIENCE=InsurancePlatformV01
JWT_SIGNING_KEY=development-only-signing-key-change-me-32-bytes-min

# Required for Analise.Api's risk-assessment feature to call the real Anthropic API.
# Left empty, the service still starts - AI calls fail fast into a "Falha" analysis
# instead of blocking anything else (see design.md decision 6/11).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
